.build/
.swiftpm/
.DS_Store
*.xcodeproj
*.xcworkspace

# ─────────────────────────────────────────────────────────────────────────────
# local/ — everything a session produces that must NOT be published:
# research reports, throwaway probes, ad-hoc tests, RAW fixtures, source clones.
# Only local/README.md (the convention itself) is tracked. See local/README.md.
# ─────────────────────────────────────────────────────────────────────────────
local/*
!local/README.md

# decoded image caches (large, regenerable)
.cache/
out/
*.linear
*.linear.json

# RAW fixtures are the user's own photos — never vendored
*.dng
*.cr3
*.cr2
*.nef
*.arw
*.raf
*.rw2
*.orf

# scratch by-products
*.bak
*.tmp

# 派单/规格文档只留在本机，不同步到远端（用户 2026-10-26）
docs/tasks/
